# tavily-search-mcp environment variables.
# Copy to `.env` (gitignored) and fill in any overrides.

# --- Required ---------------------------------------------------------------
# Tavily API key. Get one at https://app.tavily.com (1,000 credits/month on signup
# credits alone; pay-as-you-go kicks in after consumption). The key is sent as
# `Authorization: Bearer <key>`; it never appears in the request body.
TAVILY_API_KEY=

# --- Transport (Streamable HTTP vs stdio) -----------------------------------
# "http" (Streamable HTTP, default) or "stdio".
TAVILY_TRANSPORT=http

# Bind address when transport=http. Loopback only by design;
# VS Code's "Forward a Port" tunnels this through Microsoft's relay.
TAVILY_HOST=127.0.0.1
TAVILY_PORT=8000

# Path prefix for the Streamable HTTP endpoint. Clients must include this.
TAVILY_PATH=/mcp

# --- Cache ------------------------------------------------------------------
# On-disk cache directory for Tavily responses. Gitignored.
TAVILY_CACHE_DIR=./cache/tavily

# Cache freshness in seconds. 0 disables the cache (every call burns credits).
TAVILY_CACHE_TTL_SECS=86400

# --- Safety rails -----------------------------------------------------------
# Per-result char cap on raw_content (web_search and extract_url).
# Prevents a single call from blowing the model's context budget.
TAVILY_MAX_RAW_CHARS=8000

# Minimum spacing between upstream Tavily calls in milliseconds. The free tier
# is generous, but the polite default paces calls so a runaway loop doesn't
# burst (set 0 to disable).
TAVILY_MIN_INTERVAL_MS=200

# Upstream HTTP request timeout in seconds.
TAVILY_HTTP_TIMEOUT_S=60

# --- Search profile (applied to web_search by default) ----------------------
# search_depth: basic | advanced | fast | ultra-fast
TAVILY_SEARCH_DEPTH=advanced
# include_answer: true | false | basic | advanced
TAVILY_INCLUDE_ANSWER=basic
# include_raw_content: true | false | markdown | text
TAVILY_INCLUDE_RAW_CONTENT=markdown
# include_favicon: true | false
TAVILY_INCLUDE_FAVICON=true
# topic: general | news | finance
TAVILY_TOPIC=general
# Max chunks joined per result source (1..3). Only when search_depth is not
# "ultra-fast".
TAVILY_CHUNKS_PER_SOURCE=3

# --- Extract profile (applied to extract_url by default) -------------------
# extract_depth: basic | advanced (advanced=2 credits / 5 URLs vs 1).
TAVILY_EXTRACT_DEPTH=basic
# format: markdown | text
TAVILY_EXTRACT_FORMAT=markdown
# include_favicon for extract: true | false
TAVILY_EXTRACT_INCLUDE_FAVICON=true

# --- Logging ----------------------------------------------------------------
# Log level. Accepted: DEBUG, INFO, WARNING, ERROR. Logs go to stderr.
# Accepts both MCP_LOG_LEVEL (legacy) and FASTMCP_LOG_LEVEL (FastMCP 4 default).
MCP_LOG_LEVEL=WARNING
